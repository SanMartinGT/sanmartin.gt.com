-- Permite a cada cliente ver solo los renglones de sus propios pedidos.
-- Ejecuta este archivo UNA VEZ en Supabase > SQL Editor.

alter table public.pedidos_ecommerce_detalle enable row level security;

drop policy if exists "cliente_read_own_order_lines" on public.pedidos_ecommerce_detalle;
drop policy if exists "cliente lee detalle de sus pedidos" on public.pedidos_ecommerce_detalle;

create policy "cliente_read_own_order_lines"
on public.pedidos_ecommerce_detalle
for select
to authenticated
using (
  exists (
    select 1
    from public.pedidos_ecommerce pedido
    where pedido.id = pedidos_ecommerce_detalle.pedido_id
      and pedido.cliente_id = auth.uid()
  )
);

-- La política permite únicamente lectura; no concede INSERT, UPDATE ni DELETE.
grant select on table public.pedidos_ecommerce_detalle to authenticated;
